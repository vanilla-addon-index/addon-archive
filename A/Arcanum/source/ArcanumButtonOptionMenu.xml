			<CheckButton name="ArcanumPortalButton_Button" enableMouse="true" inherits="UICheckButtonTemplate" checked="false">
				<Size>
					<AbsDimension x="24" y="24"/>
				</Size>
				<Anchors>
					<Anchor point="TOPLEFT" relativeTo="ArcanumButtonOptionMenu" relativeFrom="TOPLEFT">
						<Offset>
							<AbsDimension x="30" y="-55"/>
						</Offset>
					</Anchor>
				</Anchors>
				<Scripts>
					<OnClick>
						if (this:GetChecked()) then
							ArcanumConfig.PortalButton = true;
							if (ArcanumConfig.BuffType == 0) then
								if (ARCANUM_SPELL_TABLE.ID[45] ~= nil) then ShowUIPanel(ArcanumButton6); end
								if (ARCANUM_SPELL_TABLE.ID[41] ~= nil) then ShowUIPanel(ArcanumButton7); end
								if (ARCANUM_SPELL_TABLE.ID[42] ~= nil) then ShowUIPanel(ArcanumButton8); end
								if (ARCANUM_SPELL_TABLE.ID[43] ~= nil) then ShowUIPanel(ArcanumButton9); end
								if (ARCANUM_SPELL_TABLE.ID[44] ~= nil) then ShowUIPanel(ArcanumButton10); end
							else
								if (ARCANUM_SPELL_TABLE.ID[55] ~= nil) then ShowUIPanel(ArcanumButton6); end
								if (ARCANUM_SPELL_TABLE.ID[51] ~= nil) then ShowUIPanel(ArcanumButton7); end
								if (ARCANUM_SPELL_TABLE.ID[52] ~= nil) then ShowUIPanel(ArcanumButton8); end
								if (ARCANUM_SPELL_TABLE.ID[53] ~= nil) then ShowUIPanel(ArcanumButton9); end
								if (ARCANUM_SPELL_TABLE.ID[54] ~= nil) then ShowUIPanel(ArcanumButton10); end
							end
						else
							ArcanumConfig.PortalButton = false;
                            HideUIPanel(ArcanumButton6);
                            HideUIPanel(ArcanumButton7);
                            HideUIPanel(ArcanumButton8);
                            HideUIPanel(ArcanumButton9);
                            HideUIPanel(ArcanumButton10);
						end
					</OnClick>
				</Scripts>
			</CheckButton>
