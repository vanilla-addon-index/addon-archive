							<AbsDimension x="30" y="-155"/>
						</Offset>
					</Anchor>
				</Anchors>
				<Scripts>
					<OnClick>
						-- only affects the button directly while it is displaying
						-- Hearthstone (solo mode); in group mode the button is
						-- governed by Atiesh auto-detection instead
						if (this:GetChecked()) then
							ArcanumConfig.HearthstoneButton = true;
							if (ArcanumConfig.BuffType == 0) then
                            ShowUIPanel(ArcanumButton5);
							end
						else
							ArcanumConfig.HearthstoneButton = false;
							if (ArcanumConfig.BuffType == 0) then
                            HideUIPanel(ArcanumButton5);
							end
						end
					</OnClick>
