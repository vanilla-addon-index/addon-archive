						<Offset>
							<AbsDimension x="30" y="-175"/>
						</Offset>
					</Anchor>
				</Anchors>
				<Scripts>
					<OnClick>
						-- manual override on top of Atiesh auto-detection; only
						-- affects the button directly while it is displaying
						-- Karazhan (group mode)
						if (this:GetChecked()) then
							ArcanumConfig.KarazhanButton = true;
							if (ArcanumConfig.BuffType == 1 and Arcanum_HasAtiesh()) then
                            ShowUIPanel(ArcanumButton5);
							end
						else
							ArcanumConfig.KarazhanButton = false;
							if (ArcanumConfig.BuffType == 1) then
                            HideUIPanel(ArcanumButton5);
							end
						end
					</OnClick>
				</Scripts>
